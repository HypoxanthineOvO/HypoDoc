\newcommand{\HypoSetMetadata}[2]{%
  \ifcsdef{Hypo@metadata@#1}
    {\csgdef{Hypo@metadata@#1}{#2}}
    {\PackageWarning{hypolatex-beamer}{Unknown metadata key `#1'}}%
}

\newcommand{\HypoMetadata}[1]{%
  \ifcsdef{Hypo@metadata@#1}{\csuse{Hypo@metadata@#1}}{}%
}

% Expandable-safe metadata emptiness test. \ifstrempty does not expand its
% argument, so testing \HypoMetadata{...} directly always takes the non-empty
% branch.
\newcommand{\HypoIfMetadataEmptyTF}[3]{%
  \edef\Hypo@tmp{\HypoMetadata{#1}}%
  \ifx\Hypo@tmp\@empty
    #2%
  \else
    #3%
  \fi
}

% ---------------------------------------------------------------------------
% Palette
% ---------------------------------------------------------------------------

% Applies one accent color everywhere it is consumed. beamer snapshots colors
% at \setbeamercolor time, so every dependent must be re-set on each call;
% themes force their own accent by calling this with their hex value.
\newcommand{\HypoSetAccent}[1]{%
  \definecolor{HypoBeamerMain}{HTML}{#1}%
  \setbeamercolor{structure}{fg=HypoBeamerMain}%
  \setbeamercolor{alerted text}{fg=HypoBeamerMain}%
  \setbeamercolor{block title}{fg=HypoBeamerMain}%
  \setbeamercolor{itemize item}{fg=HypoBeamerMain}%
  \setbeamercolor{enumerate item}{fg=HypoBeamerMain}%
  \colorlet{HypoTableHead}{HypoBeamerMain!82!white}%
  \colorlet{HypoTableRowHead}{HypoBeamerMain!10!white}%
}

\newcommand{\HypoApplyPalette}[1]{%
  \ifstrequal{#1}{red}{%
    \HypoSetAccent{B91C1C}%
  }{%
    \ifstrequal{#1}{blue}{%
      \HypoSetAccent{1D4ED8}%
    }{%
      \ifstrequal{#1}{yellow}{%
        \HypoSetAccent{B45309}%
      }{%
        \ifstrequal{#1}{gray}{%
          \HypoSetAccent{374151}%
        }{%
          \ifstrequal{#1}{mono}{%
            \HypoSetAccent{111827}%
          }{%
            \PackageWarning{hypolatex-beamer}{Unknown palette `#1`; using red}%
            \HypoSetAccent{B91C1C}%
          }%
        }%
      }%
    }%
  }%
}

% ---------------------------------------------------------------------------
% Header (frametitle): breadcrumb, ink title, accent rule into hairline
% ---------------------------------------------------------------------------

% A 2.2pt accent segment at the left margin merging into a full-width
% 0.45pt hairline; used below the frame title and on divider pages.
\newcommand{\HypoHeadRule}{%
  \leavevmode
  \rlap{\color{HypoBeamerMain}\rule[-0.35pt]{14mm}{2.2pt}}%
  {\color{HypoBeamerHair}\rule[-0.35pt]{\linewidth}{0.45pt}}%
}

\setbeamertemplate{frametitle}{%
  \vspace*{0.85em}%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.6em,rightskip=1.6em]{frametitle}%
    \ifnum\value{section}>0\relax
      {\scriptsize\mdseries
       {\color{HypoBeamerMuted}\insertsection}%
       \ifnum\value{subsection}>0\relax
         \enspace{\color{HypoBeamerHair}/}\enspace{\color{HypoBeamerMain}\insertsubsection}%
       \fi\par}%
      \vspace{0.4ex}%
    \fi
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
    \vspace{0.6ex}%
    \HypoHeadRule
  \end{beamercolorbox}%
}

% ---------------------------------------------------------------------------
% Footer (footline): hairline, muted metadata, ink page number
% ---------------------------------------------------------------------------

\newcommand{\HypoFootlineFull}{%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.6em,rightskip=1.6em,sep=0pt]{footline}%
    {\color{HypoBeamerHair}\rule{\linewidth}{0.45pt}\par}%
    \vspace{0.55ex}%
    {\usebeamerfont{footline}%
     \insertshorttitle
     \hfill
     \@ifundefined{beamer@shortauthor}{}{%
       \ifx\beamer@shortauthor\@empty\else
         \insertshortauthor\enspace{\color{HypoBeamerHair}·}\enspace
       \fi
     }%
     {\color{HypoBeamerInk}\insertframenumber}\,/\,\inserttotalframenumber\par}%
    \vspace{0.95ex}%
  \end{beamercolorbox}%
}

\newcommand{\HypoFootlinePage}{%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.6em,rightskip=1.6em,sep=0pt]{footline}%
    {\color{HypoBeamerHair}\rule{\linewidth}{0.45pt}\par}%
    \vspace{0.55ex}%
    {\usebeamerfont{footline}%
     \hfill
     {\color{HypoBeamerInk}\insertframenumber}\,/\,\inserttotalframenumber\par}%
    \vspace{0.95ex}%
  \end{beamercolorbox}%
}

\newcommand{\HypoApplyFootline}[1]{%
  \ifstrequal{#1}{full}{%
    \setbeamertemplate{footline}{\HypoFootlineFull}%
  }{%
    \ifstrequal{#1}{page}{%
      \setbeamertemplate{footline}{\HypoFootlinePage}%
    }{%
      \ifstrequal{#1}{none}{%
        \setbeamertemplate{footline}{}%
      }{%
        \PackageWarning{hypolatex-beamer}{Unknown footline `#1`; using full}%
        \HypoApplyFootline{full}%
      }%
    }%
  }%
}

% ---------------------------------------------------------------------------
% Title page and section divider
% ---------------------------------------------------------------------------

\setbeamertemplate{title page}{%
  \vspace*{3.2em}%
  \hspace*{1.6em}%
  \begin{minipage}{\dimexpr\paperwidth-3.2em\relax}%
    \raggedright
    \edef\@hypo@logopath{\HypoMetadata{logo}}%
    \ifx\@hypo@logopath\@empty\else
      \hfill\includegraphics[height=1.05cm]{\@hypo@logopath}\par
      \vspace{1.1em}%
    \fi
    \HypoIfMetadataEmptyTF{organization}{%
      \HypoIfMetadataEmptyTF{course}{}{%
        {\usebeamerfont{date}\bfseries\color{HypoBeamerMain}\HypoMetadata{course}\par}%
        \vspace{0.7em}%
      }%
    }{%
      {\usebeamerfont{date}\bfseries\color{HypoBeamerMain}\HypoMetadata{organization}\par}%
      \vspace{0.7em}%
    }%
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
    \vspace{0.75em}%
    \HypoHeadRule
    \ifx\insertsubtitle\@empty\else
      \vspace{0.85em}%
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    \fi
    \vspace{2.4em}%
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
    \vspace{0.5em}%
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
  \end{minipage}%
  \vfill
}

\setbeamertemplate{section page}{%
  \vspace*{2.6em}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.6em,rightskip=1.6em]{section page}%
    {\color{HypoBeamerMain!16!white}\fontsize{40}{40}\selectfont\bfseries\thesection\par}%
    \vspace{0.15em}%
    {\usebeamerfont{section page}\usebeamercolor[fg]{section page}\insertsection\par}%
    \vspace{0.7ex}%
    \HypoHeadRule
    \vspace{1.1em}%
    \HypoAgendaStrip
  \end{beamercolorbox}%
  \vfill
}

\AtBeginSection[]{%
  \begin{frame}[plain]%
    \sectionpage%
  \end{frame}%
}

% ---------------------------------------------------------------------------
% Table of contents: numbered balls, numbered subsections, adaptive spacing
% ---------------------------------------------------------------------------

% Section entry: accent ball with white number, ink bold title. Stretchable
% glue before each entry spreads the rows across the frame height.
\newcommand{\HypoTOCSectionSkip}{\vspace{0.45em plus 0.8fill}}
\newcommand{\HypoTOCShadedSkip}{\vspace{0.4em plus 0.4fill}}
\defbeamertemplate{section in toc}{hypo}{%
  \par\HypoTOCSectionSkip%
  \leavevmode\leftskip=2.2em%
  \llap{%
    \usebeamerfont*{section number projected}%
    \usebeamercolor{section number projected}%
    \begin{pgfpicture}{-1ex}{0ex}{1ex}{2ex}
      \color{bg}%
      \pgfpathcircle{\pgfpoint{0pt}{.75ex}}{1.2ex}%
      \pgfusepath{fill}%
      \pgftext[base]{\color{fg}\inserttocsectionnumber}%
    \end{pgfpicture}\kern1.4ex%
  }%
  {\usebeamerfont{section in toc}\usebeamercolor[fg]{section in toc}\inserttocsection\par}%
}

% Subsection entry: indented "1.1" style number, muted smaller title.
\defbeamertemplate{subsection in toc}{hypo}{%
  \par\vspace{0.25em}%
  \leavevmode\leftskip=2.2em%
  {\usebeamerfont{subsection in toc}\usebeamercolor[fg]{subsection in toc}%
   \inserttocsectionnumber.\inserttocsubsectionnumber\enspace\inserttocsubsection\par}%
}

% Shaded (non-current) section entry for divider agendas: pale accent ball
% and muted title, readable instead of beamer's near-invisible 35% dilution.
\defbeamertemplate{section in toc shaded}{hypo}{%
  \par\HypoTOCShadedSkip%
  \leavevmode\leftskip=2.2em%
  \llap{%
    \usebeamercolor{section in toc shaded}%
    \begin{pgfpicture}{-1ex}{0ex}{1ex}{2ex}
      \color{fg!35!white}%
      \pgfpathcircle{\pgfpoint{0pt}{.75ex}}{1.2ex}%
      \pgfusepath{fill}%
      \pgftext[base]{\color{fg!85!black}\bfseries\footnotesize\inserttocsectionnumber}%
    \end{pgfpicture}\kern1.4ex%
  }%
  {\usebeamerfont{subsection in toc}\usebeamercolor[fg]{section in toc shaded}\inserttocsection\par}%
}

\setbeamertemplate{section in toc}[hypo]
\setbeamertemplate{subsection in toc}[hypo]
\setbeamertemplate{section in toc shaded}[hypo]
\setbeamercolor{section number projected}{bg=HypoBeamerMain,fg=white}
\setbeamercolor{section in toc}{fg=HypoBeamerInk}
\setbeamercolor{subsection in toc}{fg=HypoBeamerMuted}
\setbeamerfont{section in toc}{size=\normalsize,series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small}

% TOC page hook: themes override this to restyle the whole page.
% Two fixed-range columns keep large tables of contents on the page: column 1
% shows sections 1-4, column 2 sections 5-16 (empty for small decks).
\newcommand{\HypoTOCColumns}{%
  \begin{minipage}[t]{0.48\linewidth}%
    \tableofcontents[sections={1-4}]%
  \end{minipage}\hfill%
  \begin{minipage}[t]{0.48\linewidth}%
    \tableofcontents[sections={5-16}]%
  \end{minipage}%
}

\newcommand{\HypoTOCPage}{%
  \begin{frame}
    \frametitle{\contentsname}%
    \HypoTOCColumns
  \end{frame}%
}

% Compact agenda strip used on section divider pages: all section titles in a
% row, the current one in the accent color, the rest muted. The navigation is
% kept to a centered 0.62\paperwidth band so few sections do not scatter.
\newcommand{\HypoAgendaStrip}{%
  \begin{center}%
    {\footnotesize\insertsectionnavigationhorizontal{0.62\paperwidth}{\hskip0.6em}{\hskip0.6em}}%
  \end{center}%
}
\setbeamercolor{section in head/foot}{fg=HypoBeamerMain}
\setbeamercolor{section in head/foot shaded}{fg=HypoBeamerMuted}

% ---------------------------------------------------------------------------
% Fonts: modern screen sans for Latin, Noto CJK for Chinese, clean mono
% ---------------------------------------------------------------------------

\IfFontExistsTF{Inter}{%
  \setsansfont{Inter}%
}{%
  \IfFontExistsTF{Noto Sans}{%
    \setsansfont{Noto Sans}%
  }{}%
}
\IfFontExistsTF{Noto Sans Mono}{%
  \setmonofont{Noto Sans Mono}%
}{}

% Body text is serif across Beamer decks: Times-like Latin paired with a Song
% (Noto Serif CJK) face; headings use the bold cuts. Sans and mono remain
% available for labels and code.
\IfFontExistsTF{TeX Gyre Termes}{%
  \setmainfont{TeX Gyre Termes}[BoldFont={TeX Gyre Termes Bold}]%
}{}

% Math always uses a Times-like serif face. TeX Gyre Termes Math via
% unicode-math gives real \mathbb/\mathcal glyphs; without that font we fall
% back to beamer's serif math so slides never get sans math.
\IfFontExistsTF{TeX Gyre Termes Math}{%
  \RequirePackage{unicode-math}%
  \setmathfont{TeX Gyre Termes Math}%
}{%
  \usefonttheme[onlymath]{serif}%
}

% Fully expand a metadata value into a literal string, then hand it to an
% apply command such as \HypoApplyPalette. \ifstrequal does not expand its
% arguments, so the value must be flattened with \edef first.
\newcommand{\HypoApplyMetadataValue}[2]{%
  \ifcsdef{Hypo@metadata@#1}{%
    \expandafter\edef\expandafter\Hypo@tmp\expandafter{\csname Hypo@metadata@#1\endcsname}%
  }{%
    \def\Hypo@tmp{}%
  }%
  \expandafter#2\expandafter{\Hypo@tmp}%
}

\AtBeginDocument{%
  \HypoApplyMetadataValue{palette}{\HypoApplyPalette}%
  \renewcommand{\familydefault}{\rmdefault}%
  \renewcommand{\CJKfamilydefault}{\CJKrmdefault}%
  \normalfont%
  \@ifundefined{IfFontExistsTF}{}{%
    \IfFontExistsTF{Noto Serif CJK SC}{%
      \IfFontExistsTF{Noto Serif CJK SC Bold}{%
        \setCJKmainfont{Noto Serif CJK SC}[BoldFont={Noto Serif CJK SC Bold}]%
      }{%
        \setCJKmainfont{Noto Serif CJK SC}%
      }%
    }{}%
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \IfFontExistsTF{Noto Sans CJK SC Bold}{%
        \setCJKsansfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold}]%
      }{%
        \setCJKsansfont{Noto Sans CJK SC}%
      }%
    }{}%
    \IfFontExistsTF{Noto Sans Mono CJK SC}{%
      \setCJKmonofont{Noto Sans Mono CJK SC}%
    }{}%
  }%
  \HypoApplyMetadataValue{footline}{\HypoApplyFootline}%
}

% ---------------------------------------------------------------------------
% Answer modes and misc helpers
