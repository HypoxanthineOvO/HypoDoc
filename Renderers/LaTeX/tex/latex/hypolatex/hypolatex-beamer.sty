% ---------------------------------------------------------------------------
% Design tokens
%
% The visual system is a light "editorial" deck: white canvas, ink text, one
% restrained accent per palette, neutral hairlines and panels. Accent color is
% used sparingly (short rules, labels, markers) instead of full-bleed slabs.
% ---------------------------------------------------------------------------

\definecolor{HypoBeamerMain}{HTML}{B91C1C}
\definecolor{HypoBeamerInk}{HTML}{111827}
\definecolor{HypoBeamerBody}{HTML}{1F2937}
\definecolor{HypoBeamerMuted}{HTML}{6B7280}
\definecolor{HypoBeamerHair}{HTML}{E5E7EB}
\definecolor{HypoBeamerPanel}{HTML}{F8FAFC}
\definecolor{HypoTableStripe}{HTML}{F6F8FA}
% Table header/row-header blocks follow the palette accent.
\colorlet{HypoTableHead}{HypoBeamerMain!82!white}
\colorlet{HypoTableHeadFg}{white}
\colorlet{HypoTableRowHead}{HypoBeamerMain!10!white}

% Role colors for callout blocks, aligned with the longform theme tokens.
\definecolor{HypoRoleNote}{HTML}{475569}
\definecolor{HypoRoleTip}{HTML}{15803D}
\definecolor{HypoRoleWarning}{HTML}{C2410C}
\definecolor{HypoRoleSummary}{HTML}{1D4ED8}

\setbeamercolor{normal text}{fg=HypoBeamerBody,bg=white}
\setbeamercolor{structure}{fg=HypoBeamerMain}
\setbeamercolor{alerted text}{fg=HypoBeamerMain}
\setbeamercolor{frametitle}{fg=HypoBeamerInk,bg=white}
\setbeamercolor{title}{fg=HypoBeamerInk,bg=white}
\setbeamercolor{subtitle}{fg=HypoBeamerMuted}
\setbeamercolor{author}{fg=HypoBeamerBody}
\setbeamercolor{date}{fg=HypoBeamerMuted}
\setbeamercolor{section page}{fg=HypoBeamerInk,bg=white}
\setbeamercolor{footline}{fg=HypoBeamerMuted,bg=white}
\setbeamercolor{block title}{fg=HypoBeamerMain,bg=HypoBeamerPanel}
\setbeamercolor{block body}{fg=HypoBeamerBody,bg=HypoBeamerPanel}
\setbeamercolor{itemize item}{fg=HypoBeamerMain}
\setbeamercolor{itemize subitem}{fg=HypoBeamerMuted}
\setbeamercolor{itemize subsubitem}{fg=HypoBeamerMuted}
\setbeamercolor{enumerate item}{fg=HypoBeamerMain}
\setbeamercolor{caption name}{fg=HypoBeamerMuted}

% Families are pinned explicitly: beamer's font-inherit root falls back to
% \rmfamily once a font's parent chain is reset, which would silently mix
% serif runs into sans themes. Themes that want sans override these.
\setbeamerfont{frametitle}{size=\Large,series=\bfseries,family=\rmfamily}
\setbeamerfont{title}{size=\huge,series=\bfseries,family=\rmfamily}
\setbeamerfont{subtitle}{size=\large,family=\rmfamily}
\setbeamerfont{author}{size=\small,family=\rmfamily}
\setbeamerfont{date}{size=\small,family=\rmfamily}
\setbeamerfont{footline}{size=\scriptsize,family=\rmfamily}
\setbeamerfont{section page}{size=\LARGE,series=\bfseries,family=\rmfamily}
\setbeamerfont{caption}{size=\small,family=\rmfamily}
\setbeamerfont{caption name}{series=\bfseries}

% Consistent, slightly generous text margins; header and footer rules align
% to the same left/right edges.
\setbeamersize{text margin left=1.6em,text margin right=1.6em}

% List markers (global contract, theme-independent): level 1 is a solid dot,
% level 2 a hollow ring, level 3 a solid square. All three share the same
% visual diameter of roughly one third of the current font size.
\newcommand{\HypoMarkDot}{%
  \tikz[baseline=-0.5ex]{\fill (0,0) circle[radius=0.165em];}}
\newcommand{\HypoMarkRing}{%
  \tikz[baseline=-0.5ex]{\draw[line width=0.055em] (0,0) circle[radius=0.1375em];}}
\newcommand{\HypoMarkSquare}{%
  \tikz[baseline=-0.5ex]{\fill (-0.165em,-0.165em) rectangle (0.165em,0.165em);}}
\setbeamertemplate{itemize item}{\HypoMarkDot}
\setbeamertemplate{itemize subitem}{\HypoMarkRing}
\setbeamertemplate{itemize subsubitem}{\HypoMarkSquare}
\setbeamertemplate{enumerate item}{\insertenumlabel.}

