\newcommand{\HypoSetAnswerMode}[1]{%
  \renewcommand{\Hypo@answer@mode}{#1}%
  \ifstrequal{#1}{student}{%
    \Hypo@showanswersfalse
  }{%
    \ifstrequal{#1}{review}{%
      \Hypo@showanswerstrue
    }{%
      \ifstrequal{#1}{teacher}{%
        \Hypo@showanswerstrue
      }{%
        \PackageError{hypolatex-beamer}{Unknown answer mode `#1`}{Supported answer modes: student, review, teacher.}%
      }%
    }%
  }%
}

\newcommand{\HypoIfAnswerVisibleTF}[2]{%
  \ifHypo@showanswers
    #1%
  \else
    #2%
  \fi
}

% Loads a named Beamer style package (hypolatex-beamer-<theme>.sty) when one
% exists; otherwise falls back to the base visual defined in this package.
\newcommand{\HypoUseTheme}[1]{%
  \IfFileExists{hypolatex-beamer-#1.sty}{%
    \usepackage{hypolatex-beamer-#1}%
  }{%
    \PackageInfo{hypolatex-beamer}{No Beamer style package for theme `#1`; using base style}%
  }%
}

\newcommand{\HypoRef}[1]{\ref{#1}}

\newcommand{\HypoFigureEx}[5]{%
  \begin{figure}
    \centering
    \IfFileExists{#2}{%
      \includegraphics[width=#4]{#2}%
    }{%
      \fbox{%
        \parbox[c][0.32\textheight][c]{0.78\linewidth}{%
          \centering
          \small Figure asset unavailable\\[0.4em]
          \ttfamily\detokenize{#2}%
        }%
      }%
    }%
    \caption{#3}%
    \ifstrempty{#1}{}{\label{#1}}%
  \end{figure}%
}

\newcommand{\HypoFigure}[3]{%
  \HypoFigureEx{#1}{#2}{#3}{0.82\linewidth}{htbp}%
}

% ---------------------------------------------------------------------------
% Blocks: borderless neutral panel, colored west bar, colored label title
% ---------------------------------------------------------------------------

% HypoBlockBox[bar/label color]{title}
\newtcolorbox{HypoBlockBox}[2][HypoBeamerMain]{%
  enhanced,
  frame hidden,
  boxrule=0pt,
  arc=1.2pt,
  colback=HypoBeamerPanel,
  borderline west={2.2pt}{0pt}{#1},
  colbacktitle=HypoBeamerPanel,
  coltitle=#1,
  fonttitle=\bfseries\small,
  title={#2},
  left=8pt,
  right=8pt,
  top=5pt,
  bottom=6pt,
  boxsep=0pt,
  toptitle=5pt,
  bottomtitle=2pt,
  before skip=9pt,
  after skip=9pt%
}

\newtcolorbox{HypoQuoteBox}{%
  enhanced,
  frame hidden,
  boxrule=0pt,
  sharp corners,
  colback=HypoBeamerPanel,
  borderline west={2.2pt}{0pt}{HypoBeamerMuted},
  left=8pt,
  right=6pt,
  top=4pt,
  bottom=4pt,
  before skip=7pt,
  after skip=7pt%
}
\renewenvironment{quote}{\begin{HypoQuoteBox}}{\end{HypoQuoteBox}}
\renewenvironment{quotation}{\begin{HypoQuoteBox}}{\end{HypoQuoteBox}}

\NewDocumentEnvironment{HypoCodeBlock}{+b}{%
