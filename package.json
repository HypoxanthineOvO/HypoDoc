{
  "name": "hypodoc",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "conformance:portable": "tsx tools/differential-conformance.mts",
    "dev": "pnpm --filter @hypodoc/desktop dev",
    "licenses:report": "tsx tools/license-report.mts",
    "perf": "tsx tools/performance-baseline.mts",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vscode/vsce": "3.9.2",
    "electron-builder": "26.15.3",
    "tsx": "4.23.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "description": "HypoDoc monorepo: portable parser, renderers, desktop app and editor extensions."
}
